-                    gcode = octoprint.util.comm.gcode_command_for_cmd(line)
-                    extrusion_match = octoprint.util.comm.regexes_parameters[
-                        "floatE"
-                    ].search(line)
+                    extrusion = is_extrusion_move(line)
                     if line.startswith(";"):
